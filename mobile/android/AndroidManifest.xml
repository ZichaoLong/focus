<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="org.focus.mobile" android:versionName="1.1.0" android:versionCode="2">
    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="35"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <application android:label="Focus" android:allowBackup="false" android:usesCleartextTraffic="false" android:networkSecurityConfig="@xml/focus_network" android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity android:name=".ClientActivity" android:taskAffinity="org.focus.mobile.tab1"
